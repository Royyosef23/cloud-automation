{
  "name": "cloudit-usb-automations",
  "version": "1.0.0",
  "description": "Automated Windows ISO customization with unattended installation",
  "main": "dist/unattended/merge.js",
  "scripts": {
    "build": "npx tsc && node dist/unattended/merge.js",
    "build-xml": "npx tsc && node dist/unattended/merge.js",
    "build-iso": "powershell -ExecutionPolicy Bypass -File complete-build.ps1",
    "compile": "npx tsc",
    "test": "jest",
    "test:watch": "npx tsc --watch",
    "validate": "npx tsc --noEmit",
    "verify": "npx tsc && node dist/tests/verify-improvements.js",
    "clean": "powershell -Command \"Remove-Item -Path 'unattended/build/*', 'iso/extracted/*', 'dist/*' -Recurse -Force -ErrorAction SilentlyContinue\"",
    "dev": "npx tsc --watch"
  },
  "keywords": [
    "windows",
    "automation",
    "iso",
    "unattended",
    "installation",
    "deployment"
  ],
  "author": "CloudIT",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClickIDF/cloudit-usb-automations.git"
  },
  "bugs": {
    "url": "https://github.com/ClickIDF/cloudit-usb-automations/issues"
  },
  "homepage": "https://github.com/ClickIDF/cloudit-usb-automations#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.0.5",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "unattended/**/*.ts"
    ]
  }
}
